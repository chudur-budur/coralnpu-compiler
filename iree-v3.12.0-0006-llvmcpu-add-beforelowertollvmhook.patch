 .../iree/compiler/Codegen/Common/Transforms.h |  4 ++
 .../LLVMCPU/LLVMCPUVirtualVectorLowering.cpp  | 40 ++++++++++++++++--
 .../iree/compiler/Codegen/LLVMCPU/Passes.cpp  | 11 +++--
 .../iree/compiler/Codegen/LLVMCPU/Passes.h    |  8 ++--
 5 files changed, 60 insertions(+), 11 deletions(-)

