@@ -684,9 +684,10 @@ void buildLLVMCPUCodegenConfigurationPassPipeline(
   buildLLVMCPUCodegenConfigurationPassPipelineImpl(modulePassManager, cpuOpts);
 }
 
-void buildLLVMCPUCodegenPassPipeline(OpPassManager &modulePassManager,
-                                     const LLVMCPUPipelineOptions &pipelineOpts,
-                                     bool includeLLVMLowering) {
+void buildLLVMCPUCodegenPassPipeline(
+    OpPassManager &modulePassManager,
+    const LLVMCPUPipelineOptions &pipelineOpts, bool includeLLVMLowering,
+    std::function<void(OpPassManager &)> beforeLowerToLLVMHook) {
   modulePassManager.addPass(createLowerExecutableUsingTransformDialectPass());
   FunctionLikeNest(modulePassManager)
       .addPass([&]() {
@@ -703,6 +704,10 @@ void buildLLVMCPUCodegenPassPipeline(OpPassManager &modulePassManager,
   modulePassManager.addPass(createIREELowerAffinePass());
   modulePassManager.addPass(IREE::Util::createDropCompilerHintsPass());
 
+  if (beforeLowerToLLVMHook) {
+    beforeLowerToLLVMHook(modulePassManager);
+  }
+
   if (includeLLVMLowering) {
     addLowerToLLVMPasses(modulePassManager, pipelineOpts);
   }
