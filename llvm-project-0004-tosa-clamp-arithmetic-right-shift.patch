From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lun Dong <lundong@google.com>
Date: Wed, 21 Oct 2026 09:55:00 -0700
Subject: [PATCH] [mlir][tosa] Clamp out-of-range shifts in tosa.arithmetic_right_shift

tosa.arithmetic_right_shift lowers to arith.shrsi (plus arith.shrsi by
shift - 1 when round = true), which produces poison when the shift is at
least the element bit width (for example, TFLite-to-TOSA int8 softmax
emits 35 - clz(sum_of_exps), which reaches 32 when the sum of exps in
Q12.19 is >= 512). Clamp both shift amounts to bitwidth - 1 with
arith.minui so out-of-range shifts sign-fill and round to 0.
---
 mlir/lib/Conversion/TosaToLinalg/TosaToLinalg.cpp     | 14 ++++++++++++--
 mlir/test/Conversion/TosaToLinalg/tosa-to-linalg.mlir |  6 ++++++
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/mlir/lib/Conversion/TosaToLinalg/TosaToLinalg.cpp b/mlir/lib/Conversion/TosaToLinalg/TosaToLinalg.cpp
index b7eb0a3aed5..92aebddf8f2 100644
--- a/mlir/lib/Conversion/TosaToLinalg/TosaToLinalg.cpp
+++ b/mlir/lib/Conversion/TosaToLinalg/TosaToLinalg.cpp
@@ -290,7 +290,15 @@ static Value createLinalgBodyCalculationForElementwiseOp(
 
   // tosa::ArithmeticRightShiftOp
   if (isa<tosa::ArithmeticRightShiftOp>(op) && isa<IntegerType>(elementTy)) {
-    auto result = arith::ShRSIOp::create(rewriter, loc, resultTypes, args);
+    // arith.shrsi is poison for shifts of the bit width or more. Clamp them,
+    // so that they fill with the sign bit and, with rounding, give 0, as the
+    // rounded division by 2^shift does.
+    auto maxShift = arith::ConstantOp::create(
+        rewriter, loc,
+        IntegerAttr::get(elementTy, elementTy.getIntOrFloatBitWidth() - 1));
+    auto amount = arith::MinUIOp::create(rewriter, loc, args[1], maxShift);
+    auto result =
+        arith::ShRSIOp::create(rewriter, loc, resultTypes, args[0], amount);
     bool round = cast<tosa::ArithmeticRightShiftOp>(op).getRound();
     if (!round) {
       return result;
@@ -313,8 +321,10 @@ static Value createLinalgBodyCalculationForElementwiseOp(
     // Checking for the last bit of input1 to be 1
     auto subtract =
         arith::SubIOp::create(rewriter, loc, resultTypes, args[1], one);
+    auto roundAmount =
+        arith::MinUIOp::create(rewriter, loc, subtract, maxShift);
     auto shifted =
-        arith::ShRSIOp::create(rewriter, loc, resultTypes, args[0], subtract)
+        arith::ShRSIOp::create(rewriter, loc, resultTypes, args[0], roundAmount)
             ->getResults();
     auto truncated = arith::TruncIOp::create(rewriter, loc, i1Ty, shifted,
                                              ArrayRef<NamedAttribute>());
diff --git a/mlir/test/Conversion/TosaToLinalg/tosa-to-linalg.mlir b/mlir/test/Conversion/TosaToLinalg/tosa-to-linalg.mlir
index a803ee7d991..2f42214219d 100644
--- a/mlir/test/Conversion/TosaToLinalg/tosa-to-linalg.mlir
+++ b/mlir/test/Conversion/TosaToLinalg/tosa-to-linalg.mlir
@@ -698,16 +698,22 @@ func.func @test_simple_i32(%arg0: tensor<1xi32>, %unsigned: tensor<1xui32>, %uns
   %10 = tosa.logical_right_shift %arg0, %arg0 : (tensor<1xi32>, tensor<1xi32>) -> tensor<1xi32>
 
   // CHECK: linalg.generic
+  // CHECK: arith.constant 31
+  // CHECK: arith.minui
   // CHECK: arith.shrsi
   %11 = tosa.arithmetic_right_shift %arg0, %arg0 {round = 0 : i1} : (tensor<1xi32>, tensor<1xi32>) -> tensor<1xi32>
 
   // CHECK: linalg.generic
+  // CHECK: arith.constant 31
+  // CHECK: arith.minui
+  // CHECK: arith.shrsi
   // CHECK: arith.constant 1
   // CHECK: arith.constant 0
   // CHECK: arith.constant false
   // CHECK: arith.constant true
   // CHECK: arith.cmpi
   // CHECK: arith.subi
+  // CHECK: arith.minui
   // CHECK: arith.shrsi
   // CHECK: arith.trunci
   // CHECK: and
