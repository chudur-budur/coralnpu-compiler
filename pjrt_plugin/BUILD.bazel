load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

cc_library(
    name = "client",
    srcs = ["client.cc"],
    hdrs = ["client.h"],
    deps = [
        "//runtime/driver/registration",
        "@com_google_protobuf//:protobuf",
        "@iree_core//integrations/pjrt/src/iree_pjrt/common",
        "@iree_core//runtime/src/iree/async",
        "@iree_core//runtime/src/iree/base",
        "@iree_core//runtime/src/iree/hal",
        "@iree_core//runtime/src/iree/hal/drivers/local_sync/registration",
    ],
)

cc_library(
    name = "dylib",
    srcs = ["dylib_entry_point.cc"],
    defines = [
        "PJRT_PLUGIN_BUILDING_LIBRARY",
    ],
    deps = [
        ":client",
        "@iree_core//integrations/pjrt/src/iree_pjrt/common",
        "@iree_core//integrations/pjrt/src/iree_pjrt/common:dylib_platform",
    ],
    alwayslink = True,
)

cc_shared_library(
    name = "iree_pjrt_coralnpu_dylib",
    additional_linker_inputs = [
        ":export.map",
    ],
    user_link_flags = [
        # Fail the link on unresolved symbols instead of failing at dlopen.
        "-Wl,--no-undefined",
        # Bind references to our own definitions so other libraries loaded in
        # the process cannot interpose them.
        "-Wl,-Bsymbolic",
        "-Wl,--version-script=$(execpath :export.map)",
    ],
    deps = [
        ":dylib",
    ],
)
