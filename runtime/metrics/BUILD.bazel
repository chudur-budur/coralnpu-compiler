# Per-dispatch execution statistics: the record the execution backends
# (//runtime/sim) collect, the observer interface through which the HAL
# driver (//runtime/driver) passes it on, and its consumers. Depends on
# neither the driver nor the simulators.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# The statistics of a single dispatch.
cc_library(
    name = "dispatch_stats",
    hdrs = ["dispatch_stats.h"],
)

# The interface between a HAL device and the consumer of its statistics.
cc_library(
    name = "dispatch_observer",
    hdrs = ["dispatch_observer.h"],
    deps = [
        ":dispatch_stats",
        "@iree_core//runtime/src/iree/base",
    ],
)

# Writes the statistics as JSON Lines or as a summary table
# (--coralnpu_stats_format).
cc_library(
    name = "stats_writer",
    srcs = ["stats_writer.c"],
    hdrs = ["stats_writer.h"],
    deps = [
        ":dispatch_observer",
        ":dispatch_stats",
        "@iree_core//runtime/src/iree/base",
        "@iree_core//runtime/src/iree/base/threading",
    ],
)
