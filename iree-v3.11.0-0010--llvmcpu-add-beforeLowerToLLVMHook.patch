From 8d4aadb255232f6425b7a82ee6ca146102db9b6a Mon Sep 17 00:00:00 2001
From: Shaked Flur <sflur@google.com>
Date: Sun, 12 Jul 2026 20:04:49 +0200
Subject: [PATCH 10/10] [llvmcpu] add beforeLowerToLLVMHook

---
 .../src/iree/compiler/Codegen/LLVMCPU/Passes.cpp     | 11 ++++++++---
 compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.h  |  8 +++++---
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.cpp b/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.cpp
index 3e10906055..dc4e148bf9 100644
--- a/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.cpp
+++ b/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.cpp
@@ -684,9 +684,10 @@ void buildLLVMCPUCodegenConfigurationPassPipeline(
   buildLLVMCPUCodegenConfigurationPassPipelineImpl(modulePassManager, cpuOpts);
 }
 
-void buildLLVMCPUCodegenPassPipeline(OpPassManager &modulePassManager,
-                                     const LLVMCPUPipelineOptions &pipelineOpts,
-                                     bool includeLLVMLowering) {
+void buildLLVMCPUCodegenPassPipeline(
+    OpPassManager &modulePassManager,
+    const LLVMCPUPipelineOptions &pipelineOpts, bool includeLLVMLowering,
+    std::function<void(OpPassManager &)> beforeLowerToLLVMHook) {
   modulePassManager.addPass(createLowerExecutableUsingTransformDialectPass());
   FunctionLikeNest(modulePassManager)
       .addPass([&]() {
@@ -703,6 +704,10 @@ void buildLLVMCPUCodegenPassPipeline(OpPassManager &modulePassManager,
   modulePassManager.addPass(createIREELowerAffinePass());
   modulePassManager.addPass(IREE::Util::createDropCompilerHintsPass());
 
+  if (beforeLowerToLLVMHook) {
+    beforeLowerToLLVMHook(modulePassManager);
+  }
+
   if (includeLLVMLowering) {
     addLowerToLLVMPasses(modulePassManager, pipelineOpts);
   }
diff --git a/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.h b/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.h
index 24fa6422bf..79f5a87a98 100644
--- a/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.h
+++ b/compiler/src/iree/compiler/Codegen/LLVMCPU/Passes.h
@@ -12,6 +12,7 @@
 #ifndef IREE_COMPILER_CODEGEN_LLVMCPU_PASSES_H_
 #define IREE_COMPILER_CODEGEN_LLVMCPU_PASSES_H_
 
+#include <functional>
 #include <optional>
 
 #include "iree/compiler/Codegen/Dialect/CPU/IR/IREECPUTypes.h"
@@ -146,9 +147,10 @@ void buildLLVMCPUCodegenConfigurationPassPipeline(
 /// Populates passes needed to lower high level ops, e.g., linalg, vector, etc,
 /// to LLVM dialect via the structured ops path. The `modulePassManager`
 /// should operate on the module within the IREE::HAL::ExecutableOp.
-void buildLLVMCPUCodegenPassPipeline(OpPassManager &modulePassManager,
-                                     const LLVMCPUPipelineOptions &pipelineOpts,
-                                     bool includeLLVMLowering = true);
+void buildLLVMCPUCodegenPassPipeline(
+    OpPassManager &modulePassManager,
+    const LLVMCPUPipelineOptions &pipelineOpts, bool includeLLVMLowering = true,
+    std::function<void(OpPassManager &)> beforeLowerToLLVMHook = nullptr);
 
 //----------------------------------------------------------------------------//
 // LLVMCPU Linking Passes and Pipelines
